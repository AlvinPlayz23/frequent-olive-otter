{
  "expo": {
    "name": "Atelier",
    "slug": "atelier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "atelier",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F2EA",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSCameraUsageDescription": "Atelier uses the camera to photograph pieces for your wardrobe.",
        "NSPhotoLibraryUsageDescription": "Atelier needs access to your photos so you can add pieces to your wardrobe."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F2EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F2EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Atelier needs access to your photos so you can add pieces to your wardrobe.",
          "cameraPermission": "Atelier uses the camera to photograph pieces for your wardrobe."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
